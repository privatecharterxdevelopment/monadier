# Bot Service — production template (Arbitrum V11 only)

# REQUIRED: Bot wallet — must match `bot` on MonadierTradingVaultV11
BOT_PRIVATE_KEY=0x...

# Optional: fail startup if bot address does not match (recommended)
EXPECTED_BOT_ADDRESS=0xF7072A1067194648f309A215250004abe177531a

# Bot execution — Hyperliquid perps only
HL_AGENT_MASTER_SECRET=0x...
HL_AGENT_NAME=monadier
HL_AGENT_VALIDITY_DAYS=90
HL_MIN_BOT_ACCOUNT_USD=20
# Admin builder fee wallet (HL builder + Arbitrum USDC success-fee receiver)
HL_BUILDER_ADDRESS=0x1fBc2A0Ab6a8fA5F6B9645392433483b25a8Cd84
PLATFORM_FEE_TREASURY_ADDRESS=0x1fBc2A0Ab6a8fA5F6B9645392433483b25a8Cd84
HL_BUILDER_FEE_PERP=30
HL_BUILDER_MAX_APPROVAL=0.1%
HL_OPEN_BUILDER_FEE_PERP=0
HL_SUCCESS_FEE_BPS=1000
HL_MIN_SIGNAL_CONFIDENCE=55
HL_MIN_DIRECTIONAL_TFS=2
HL_MIN_TREND_ALIGNMENT=50
# Market-regime switch (one var, two separate profile files):
#   bull_market = LONG-first (profiles/bullMarketLong.ts — current long stack)
#   bear_market = June-26→Jul-13 SHORT engine (profiles/bearMarketShort.ts)
#                 full secondary gates, scalp ON, no HTF, no LLM
#                 LONGs only as strict counter-trend (h1 UP, high conf) — not soft LONGs
# Live red market: set bear_market on Railway.
#
# Hard analysis TF rule (always, both regimes):
#   SHORT / bearish → 1m, 5m, 15m, 1h
#   LONG  / bullish → 15m, 1h, (+4h unless disabled)
HL_DIRECTION_PROFILE=bear_market
# HL_LONG_INCLUDE_4H=true   # default ON; set false to drop 4h from LONG stack
# Hard-delist (ZEC always banned in code). Extra coins: HL_EXCLUDED_COINS=FOO,BAR
HL_BLOCK_OPPOSITE_SAME_COIN_MS=900000

# Gemini Vision pre-trade confirm — only when the active profile enables it
# (bull_market). bear_market / June short pack forces LLM OFF.
# LONG → 15m + 1h (+4h) | SHORT → 1m + 5m; disagreement cycle logs evaluation_id.
HL_LLM_GATE_ENABLED=true
HL_LLM_GATE_MODE=shadow
HL_LLM_PROVIDER=gemini
HL_LLM_MODEL=gemini-2.0-flash
HL_LLM_TIMEOUT_MS=8000
# GEMINI_API_KEY=...   (Google AI Studio / Gemini API key — never commit)

# REQUIRED: Supabase (service role — server only, never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Do NOT set TREASURY_ADDRESS to the old vault treasury 0x64d79e… for fees.
# Fees go to PLATFORM_FEE_TREASURY_ADDRESS / HL_BUILDER_ADDRESS above.

# REQUIRED: V11 vault on Arbitrum (default = canonical V11)
ARBITRUM_VAULT_ADDRESS=0x7dE97f35887b2623dCad2ebA68197f58F7607854
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Production safety
NODE_ENV=production
ENABLE_DEMO_SIMULATOR=false
LOG_LEVEL=info

# --- X / Twitter auto-posts (bot-service setInterval ~60s, NOT a Railway cron) ---
# Without these four, drafts may be created but NOTHING is published to x.com:
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# Force Auto-post ON + skip admin approval (recommended for live):
# X_SOCIAL_AUTO_PUBLISH=true
# Admin dashboard Generate/Publish (same value on Vercel as VITE_BOT_ADMIN_SECRET):
# BOT_ADMIN_SECRET=
# Optional: OPENAI_API_KEY / HL_OPENAI_API_KEY for AI stats tweets (win-flyer can work without)

# Multi-user scale (1M+ signups — tune per Railway plan)
BOT_USER_CONCURRENCY=64
BOT_MAX_USERS_PER_CYCLE=5000
BOT_GLOBAL_SCAN_CONCURRENCY=24
BOT_SKIP_SUB_BOOTSTRAP=true

# Optional: Bot API auth for Supabase edge verify-bot-trade
# BOT_SERVICE_API_KEY=...

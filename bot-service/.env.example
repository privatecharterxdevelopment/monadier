# Bot Service — Hyperliquid-only (no Arbitrum vault / smart contracts)

# REQUIRED: Bot operator wallet (HL agent master fallback if HL_AGENT_MASTER_SECRET unset)
BOT_PRIVATE_KEY=0x...

# REQUIRED: Hyperliquid builder fee wallet — users approve this address on HL.
# Fund with ≥$100 USDC on Hyperliquid perps for auto success-fee collection.
HL_BUILDER_ADDRESS=0x64d79e57640A8d4A56Ad1d08c932B5CCF0B263a9
HL_BUILDER_FEE_PERP=30
HL_BUILDER_MAX_APPROVAL=0.1%
HL_OPEN_BUILDER_FEE_PERP=0
HL_SUCCESS_FEE_BPS=1000

HL_AGENT_MASTER_SECRET=0x...
HL_AGENT_NAME=monadier
HL_AGENT_VALIDITY_DAYS=90
HL_MIN_BOT_ACCOUNT_USD=20
HL_MIN_SIGNAL_CONFIDENCE=52
HL_MIN_DIRECTIONAL_TFS=2
HL_MIN_TREND_ALIGNMENT=50
HL_BLOCK_OPPOSITE_SAME_COIN_MS=900000

# REQUIRED: Supabase (service role — server only, never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Optional: watch Arbitrum USDC transfers to HL_BUILDER_ADDRESS (subscription payments)
ENABLE_ARBITRUM_PAYMENT_MONITOR=true
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Production safety
NODE_ENV=production
ENABLE_DEMO_SIMULATOR=false
LOG_LEVEL=info

# Multi-user scale
BOT_USER_CONCURRENCY=64
BOT_MAX_USERS_PER_CYCLE=5000
BOT_GLOBAL_SCAN_CONCURRENCY=24
BOT_SKIP_SUB_BOOTSTRAP=true

# Trade close emails (Resend)
RESEND_API_KEY=re_...
RESEND_FROM=Monadier <hello@monadier.io>
APP_PUBLIC_URL=https://app.monadier.io

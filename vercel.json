{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "monadier.vercel.app" }],
      "destination": "https://www.hypergain.io/:path*",
      "permanent": true
    },
    {
      "source": "/welcome",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/welcome/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sports-betting",
      "destination": "/ai-sports-betting",
      "permanent": true
    },
    {
      "source": "/sports-betting/:path*",
      "destination": "/ai-sports-betting",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/app",
      "has": [{ "type": "host", "value": "www.hypergain.io" }],
      "destination": "https://app.hypergain.io/",
      "permanent": true
    },
    {
      "source": "/app/(.*)",
      "has": [{ "type": "host", "value": "www.hypergain.io" }],
      "destination": "https://app.hypergain.io/$1",
      "permanent": true
    },
    {
      "source": "/app",
      "has": [{ "type": "host", "value": "hypergain.io" }],
      "destination": "https://app.hypergain.io/",
      "permanent": true
    },
    {
      "source": "/app/(.*)",
      "has": [{ "type": "host", "value": "hypergain.io" }],
      "destination": "https://app.hypergain.io/$1",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "has": [{ "type": "host", "value": "www.hypergain.io" }],
      "destination": "https://app.hypergain.io/",
      "permanent": true
    },
    {
      "source": "/dashboard/(.*)",
      "has": [{ "type": "host", "value": "www.hypergain.io" }],
      "destination": "https://app.hypergain.io/",
      "permanent": true
    },
    {
      "source": "/dashboard2",
      "has": [{ "type": "host", "value": "www.hypergain.io" }],
      "destination": "https://app.hypergain.io/",
      "permanent": true
    },
    {
      "source": "/dashboard2/(.*)",
      "has": [{ "type": "host", "value": "www.hypergain.io" }],
      "destination": "https://app.hypergain.io/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/bot-service/:path*",
      "destination": "https://monadier-production.up.railway.app/:path*"
    },
    {
      "source": "/((?!api/|bot-service/|assets/|images/|videos/|favicon\\.ico|favicon\\.svg|favicon-.*\\.png|apple-touch-icon\\.png|og-image.*\\.png|email-logo\\.png|robots\\.txt|sitemap\\.xml|llms\\.txt|404\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/og-image-v2.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/og-image-v3.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}

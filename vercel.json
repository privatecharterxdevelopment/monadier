{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.monadier.com" }],
      "destination": "https://monadier.com/:path*",
      "permanent": true
    },
    {
      "source": "/welcome",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/welcome/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dashboard2",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dashboard2/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/bot-service/:path*",
      "destination": "https://monadier-production.up.railway.app/:path*"
    },
    {
      "source": "/((?!api/|bot-service/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}

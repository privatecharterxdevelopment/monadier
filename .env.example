# Monadier Environment Variables
# Copy this to .env.local for local development
# Then: npm run verify:supabase  &&  supabase db push (see docs/SUPABASE_SETUP.md)

# Supabase Configuration
VITE_SUPABASE_URL=https://gbgafseabgqinnvlfslc.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Marketing site (landing, pricing, etc.)
VITE_SITE_URL=https://www.monadier.io

# Pro Trade app (app.monadier.io) — Open app links and post-login redirects
# Dev: leave unset — marketing landing at /, Pro Trade at /app
VITE_APP_URL=https://app.monadier.io

# WalletConnect / Reown Project ID (required for mobile MetaMask via WalletConnect)
# Get yours at: https://cloud.reown.com/
# Add allowlisted domains: app.monadier.io, monadier.vercel.app, localhost
VITE_REOWN_PROJECT_ID=your-reown-project-id
# Legacy alias — either variable works
VITE_WALLETCONNECT_PROJECT_ID=your-reown-project-id

# Optional: Alchemy API Key for better RPC
VITE_ALCHEMY_API_KEY=your-alchemy-api-key

# Bot service URL (MTF signals + health)
# Optional — leave unset to use /bot-service proxy (localhost + Vercel → Railway)
# VITE_BOT_API_URL=http://localhost:3001

# Comma-separated admin emails for /dashboard/monitor
VITE_ADMIN_EMAILS=admin@yourcompany.com

# Hyperliquid — builder fee wallet (required in production on Vercel)
VITE_HL_BUILDER_ADDRESS=0x64d79e57640A8d4A56Ad1d08c932B5CCF0B263a9
# VITE_HL_BUILDER_FEE_PERP=0
# VITE_HL_PRO_TRADE_SUCCESS_FEE_BPS=250
# VITE_HL_BUILDER_FEE_SPOT=50
# VITE_HL_BUILDER_MAX_APPROVAL=0.1%
# VITE_HL_BETTING_BUY_FEE=0.5%
# VITE_HL_BETTING_CASHOUT_FEE=2.5%
# VITE_HL_BETTING_MAX_APPROVAL=2.5%
# VITE_HL_BUILDER_ENABLED=true

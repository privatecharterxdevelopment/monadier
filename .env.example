# Monadier Environment Variables
# Copy this to .env.local for local development

# Supabase Configuration
VITE_SUPABASE_URL=https://gbgafseabgqinnvlfslc.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Used for OAuth / password-reset redirects (production domain)
VITE_SITE_URL=https://monadier.vercel.app

# WalletConnect / Reown Project ID
# Get yours at: https://cloud.reown.com/
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Optional: Alchemy API Key for better RPC
VITE_ALCHEMY_API_KEY=your-alchemy-api-key

# Bot service URL (MTF signals + health)
# Optional — leave unset to use /bot-service proxy (localhost + Vercel → Railway)
# VITE_BOT_API_URL=http://localhost:3001

# Comma-separated admin emails for /dashboard/monitor
VITE_ADMIN_EMAILS=admin@yourcompany.com

# Canonical V11 vault (optional override — must match bot ARBITRUM_VAULT_ADDRESS)
# VITE_VAULT_ADDRESS=0x7dE97f35887b2623dCad2ebA68197f58F7607854
